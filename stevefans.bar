<bar protocol-version="0"
     id="stevefans"
     title="SteveFans"
     version="4.0.0"
     category="social"
     description="像素风 X 粉丝看板：点阵数字、用户头像、像素柱与本机涨跌记录，跟随系统深浅色。"
     license="MIT"
     homepage="https://x.com/st7evechou"
     refresh="10m"
     material="solid"
     placements="menubar"
     open-mode="flyout"
     icon="data:image/svg+xml;base64,">

  <permissions>
    <network origin="https://api.fxtwitter.com" />
    <network origin="https://pbs.twimg.com" />
  </permissions>

  <inputs>
    <input name="users" type="string" label="X 账号" default="st7evechou" required="true"
           placeholder="st7evechou, elonmusk"
           help="逗号或空格分隔，不要带 `@`。第一个账号决定菜单栏显示的粉丝数。" />
  </inputs>

  <docs><![CDATA[像素风看板，跟随系统深浅色：浅色白底黑字，深色黑底白字。在 Inputs 里填写一个或多个 X 用户名（逗号或空格分隔，不带 @），数据来自公开的 FxTwitter API，头像来自 pbs.twimg.com。粉丝数用 5×7 点阵逐格绘制，分隔线与涨跌柱状图按像素网格绘制；涨跌按本机每天采样，仅从首次打开看板后开始积累。]]></docs>

  <script apis="localStorage shell match-media"><![CDATA[
const h = (type, props, ...children) =>
  ({ type, props: props || {}, children: children.flat().filter(c => c !== null && c !== undefined && c !== false) });
const TX = (text, props) => h("Text", props, String(text));

const W = 360;
const CARD_W = 312;                 // 336 card - 2 * 12 padding
const PIXELX = "data:image/png;base64,";
const svg = paths =>
  `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;
const XMARK = svg(`<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231z" fill="currentColor" stroke="none"/>`);
const ICON = {
  x: XMARK,
  refresh: svg(`<path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/>`),
  external: svg(`<path d="M7 7h10v10"/><path d="M7 17 17 7"/>`),
  alert: svg(`<circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/>`),
  check: svg(`<path d="M20 6 9 17l-5-5"/>`),
};
const Icon = (name, size, color, extra) =>
  h("Icon", { svg: ICON[name], ...extra,
    tw: `size-[${size || 14}px] text-${color || "textMuted"} shrink-0 ${extra && extra.tw || ""}` });

// ---------------------------------------------------------------------------
// 5x7 dot matrix with visible 1-2 DIP gaps, so every stroke reads as cells.
// ---------------------------------------------------------------------------

const GLYPH = {
  "0": ["01110", "10001", "10011", "10101", "11001", "10001", "01110"],
  "1": ["00100", "01100", "00100", "00100", "00100", "00100", "01110"],
  "2": ["01110", "10001", "00001", "00010", "00100", "01000", "11111"],
  "3": ["11111", "00010", "00100", "00010", "00001", "10001", "01110"],
  "4": ["00010", "00110", "01010", "10010", "11111", "00010", "00010"],
  "5": ["11111", "10000", "11110", "00001", "00001", "10001", "01110"],
  "6": ["00110", "01000", "10000", "11110", "10001", "10001", "01110"],
  "7": ["11111", "00001", "00010", "00100", "01000", "01000", "01000"],
  "8": ["01110", "10001", "10001", "01110", "10001", "10001", "01110"],
  "9": ["01110", "10001", "10001", "01111", "00001", "00010", "01100"],
  ".": ["00000", "00000", "00000", "00000", "00000", "01100", "01100"],
  K: ["10001", "10010", "10100", "11000", "10100", "10010", "10001"],
  M: ["10001", "11011", "10101", "10101", "10001", "10001", "10001"],
  B: ["11110", "10001", "10001", "11110", "10001", "10001", "11110"],
  "+": ["00000", "00100", "00100", "11111", "00100", "00100", "00000"],
  "-": ["00000", "00000", "00000", "11111", "00000", "00000", "00000"],
};

function dotMatrix(text, maxWidth, maxScale, color) {
  const n = text.length;
  const scale = Math.max(4, Math.min(maxScale || 10, Math.floor(maxWidth / (6 * n - 1))));
  const gap = scale >= 8 ? 2 : 1;
  const block = scale - gap;
  const commands = [];
  for (let i = 0; i < n; i++) {
    const rows = GLYPH[text[i]];
    if (!rows) continue;
    for (let r = 0; r < 7; r++) {
      for (let c = 0; c < 5; c++) {
        if (rows[r][c] !== "1") continue;
        commands.push({ op: "rect", color: color || "text",
          rect: { x: i * 6 * scale + c * scale, y: r * scale, width: block, height: block } });
      }
    }
  }
  return { commands, width: n * 6 * scale - scale, height: 7 * scale };
}

function dither(width, height, color) {
  const commands = [];
  for (let x = 0; x + 3 <= width; x += 6)
    commands.push({ op: "rect", color: color || "border", rect: { x, y: 0, width: 3, height } });
  return commands;
}

// Blocky bar chart: chunky filled columns on a dotted baseline, up to 14 days.
function pixelBars(bars, width, height) {
  const visible = bars.slice(-14);
  const commands = [];
  for (let x = 0; x < width; x += 6)
    commands.push({ op: "rect", color: "border", rect: { x, y: Math.floor(height / 2), width: 3, height: 1 } });
  if (!visible.length) {
    commands.push({ op: "text", x: 0, y: Math.floor(height / 2) - 16,
      text: "NO SAMPLES YET", size: 9, color: "textMuted" });
    return { commands, width, height };
  }
  const slot = Math.floor(width / visible.length);
  const cell = Math.max(5, Math.min(20, slot - 4));
  const step = 6, base = Math.floor(height / 2);
  const max = visible.reduce((m, b) => Math.max(m, Math.abs(b.y)), 0) || 1;
  const rows = Math.max(1, Math.floor((base - 2) / step));
  visible.forEach((b, i) => {
    const units = b.y === 0 ? 0 : Math.max(1, Math.round(Math.abs(b.y) / max * rows));
    const x = i * slot + Math.floor((slot - cell) / 2);
    for (let u = 0; u < units; u++) {
      const y = b.y >= 0 ? base - 1 - (u + 1) * step + 1 : base + 1 + u * step;
      commands.push({ op: "rect", color: b.y >= 0 ? "accent" : "danger",
        rect: { x, y, width: cell, height: cell } });
    }
  });
  return { commands, width, height };
}

// ---------------------------------------------------------------------------
// Formatting
// ---------------------------------------------------------------------------

const comma = n => String(Math.trunc(n)).replace(/\B(?=(\d{3})+(?!\d))/g, ",");
const trim = v => (v >= 100 ? v.toFixed(0) : v.toFixed(1)).replace(/\.0$/, "");
function compact(n) {
  const a = Math.abs(n);
  if (a >= 1e9) return trim(n / 1e9) + "B";
  if (a >= 1e6) return trim(n / 1e6) + "M";
  if (a >= 1e4) return trim(n / 1e3) + "K";
  return String(Math.trunc(n));
}
const heroNumber = n => (n >= 1e6 ? trim(n / 1e6) + "M" : String(Math.trunc(n)));

const dayKey = t => { const d = new Date(t); return d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, "0") + "-" + String(d.getDate()).padStart(2, "0"); };
const ago = t => {
  const s = Math.max(0, Math.round((Date.now() - t) / 1e3));
  if (s < 60) return "NOW";
  if (s < 3600) return Math.floor(s / 60) + "M";
  if (s < 86400) return Math.floor(s / 3600) + "H";
  return Math.floor(s / 86400) + "D";
};

// ---------------------------------------------------------------------------
// State
// ---------------------------------------------------------------------------

let target = [];
let inputErr = "";
let rows = [];
let error = "";
let loading = false;
let loadedAt = 0;
let inflight = null;

function parseUsers(raw) {
  const seen = new Set();
  const out = [];
  for (const part of String(raw || "").split(/[\s,，、]+/)) {
    const handle = part.trim().replace(/^@+/, "");
    if (!handle || seen.has(handle.toLowerCase())) continue;
    seen.add(handle.toLowerCase());
    out.push({ handle, key: handle.toLowerCase() });
  }
  return out;
}

function sync(env) {
  const raw = (env && env.inputs && env.inputs.users) || "";
  const next = parseUsers(raw);
  const key = next.map(t => t.key).join("|");
  if (key === sync.key) return;
  sync.key = key;
  target = next;
  inputErr = next.length ? "" : "在输入里填写至少一个 X 账号";
  rows = next.map(t => ({ handle: t.handle, data: null, error: "" }));
  error = ""; loadedAt = 0;
}

// ---------------------------------------------------------------------------
// Local daily history
// ---------------------------------------------------------------------------

function recordTrend(handleKey, followers) {
  const storeKey = "fans:" + handleKey;
  let log = {};
  try { log = JSON.parse(localStorage.getItem(storeKey) || "{}") || {}; } catch (e) {}
  log[dayKey(Date.now())] = followers;
  const days = Object.keys(log).sort().slice(-31);
  const trimmed = {};
  for (const d of days) trimmed[d] = log[d];
  localStorage.setItem(storeKey, JSON.stringify(trimmed));
}

function trendFor(handleKey, followers) {
  let log = {};
  try { log = JSON.parse(localStorage.getItem("fans:" + handleKey) || "{}") || {}; } catch (e) {}
  const days = Object.keys(log).sort();
  const today = dayKey(Date.now());
  const cutoff = dayKey(Date.now() - 7 * 864e5);
  const base = days.find(d => d >= cutoff && d < today);
  const delta = base ? followers - log[base] : null;
  const series = days.map(d => log[d]);
  const bars = [];
  for (let i = 1; i < series.length; i++) {
    const change = series[i] - series[i - 1];
    bars.push({ x: i - 1, y: change, label: days[i],
      valueLabel: (change > 0 ? "+" : "") + comma(change) + " 粉丝" });
  }
  return { bars, delta };
}

// ---------------------------------------------------------------------------
// FxTwitter API
// ---------------------------------------------------------------------------

function readUser(body, handle) {
  if (!body || typeof body !== "object") throw new Error("接口返回了无法解析的内容");
  if (body.code === 404) throw new Error(body.reason === "suspended" ? "@" + handle + " 已被冻结" : "@" + handle + " 不存在");
  if (body.code !== 200 || !body.user) throw new Error(body.message || "接口返回错误");
  const u = body.user;
  if (!Number.isFinite(u.followers) || !Number.isFinite(u.following) || !Number.isFinite(u.tweets))
    throw new Error("账号数据不完整");
  return {
    handle: String(u.screen_name || handle),
    name: String(u.name || u.screen_name || handle),
    followers: u.followers, following: u.following, tweets: u.tweets,
    avatar: String(u.avatar_url || "").replace(/_(normal|bigger|mini)\.(jpg|jpeg|png|webp)$/i, "_200x200.$2"),
    verified: !!(u.verification && u.verification.verified === true),
    joined: (String(u.joined || "").match(/\b(\d{4})\s*$/) || [, ""])[1],
    url: "https://x.com/" + encodeURIComponent(u.screen_name || handle),
  };
}

async function fetchUser(handle) {
  const res = await fetch("https://api.fxtwitter.com/" + encodeURIComponent(handle), {
    headers: { Accept: "application/json" },
    redirect: "manual",
  });
  if (res.status >= 300 && res.status < 400) throw new Error("@" + handle + " 不存在或已冻结");
  if (res.status === 429) throw new Error("请求过于频繁，请稍后再试");
  if (res.status >= 500) throw new Error("FxTwitter 服务异常（HTTP " + res.status + "）");
  let body = null;
  try { body = await res.json(); } catch (e) {}
  if (!body && !res.ok) throw new Error("请求失败（HTTP " + res.status + "）");
  return readUser(body, handle);
}

async function load() {
  const results = await Promise.all(target.map(t =>
    fetchUser(t.handle)
      .then(data => { recordTrend(t.key, data.followers); return { handle: t.handle, data, error: "" }; })
      .catch(e => ({ handle: t.handle, data: null, error: String(e && e.message || e) }))));
  if (results.some(r => r.data)) loadedAt = Date.now();
  return results;
}

function refresh() {
  if (!target.length) return Promise.resolve();
  if (inflight) return inflight;
  const t = target;
  loading = true;
  $metrix.invalidate();
  inflight = load()
    .then(res => {
      if (t !== target) return;
      rows = res;
      const failed = res.filter(r => r.error);
      error = failed.length === res.length ? failed[0].error
        : failed.length ? failed.map(r => "@" + r.handle + " 刷新失败").join("；") : "";
    })
    .catch(e => { if (t === target) error = String(e && e.message || e); })
    .finally(() => { inflight = null; loading = false; $metrix.invalidate(); });
  return inflight;
}
const launchRefresh = () => { void refresh(); };
const open = url => () => { if (url) $metrix.openURL(url); };

// ---------------------------------------------------------------------------
// Theme: semantic tokens from the host theme, alpha card borders in the same
// style as the official Tokens dashboard (isDarkTheme + [#ffffff12] / [#00000010]).
// ---------------------------------------------------------------------------

let themeHooked = false;

function isDarkTheme() {
  try {
    return !!(globalThis.matchMedia && globalThis.matchMedia("(prefers-color-scheme: dark)").matches);
  } catch (e) {
    return true;
  }
}

function hookTheme() {
  if (themeHooked) return;
  themeHooked = true;
  try {
    const mq = matchMedia("(prefers-color-scheme: dark)");
    mq.addEventListener("change", () => $metrix.invalidate());
  } catch (e) {}
}

const cardBorder = () => (isDarkTheme() ? "[#ffffff12]" : "[#00000010]");
const K = { muted: "textMuted", hover: "surfaceHover", press: "surfacePressed",
  line: "border", up: "success", down: "danger", accent: "accent" };
const LABEL = "font-mono text-[9px] tracking-[1.5px]";

function IconButton(name, label, onClick, busy) {
  return h("Column", {
    tw: "w-6 h-6 items-center justify-center shrink-0 cursor-pointer",
    hover: { background: K.hover }, pressed: { background: K.press },
    label, tooltip: label, onClick,
  }, Icon(name, 14, K.muted, busy ? { keyframes: { duration: 900, repeat: -1, ease: "linear",
    frames: [{ at: 0, rotate: 0 }, { at: 1, rotate: 360 }] } } : null));
}

function Header() {
  return h("Column", { tw: "w-full" },
    h("Row", { tw: "gap-2 py-3 px-3 items-center w-full min-w-0" },
      Icon("x", 15, "text"),
      TX("STEVE FANS", { tw: "font-mono text-[11px] font-semibold tracking-[2px] truncate min-w-0" }),
      h("Spacer"),
      TX(loadedAt ? ago(loadedAt) : "", { tw: "font-mono text-[9px] text-textMuted tabular-nums shrink-0" }),
      target.length ? IconButton("refresh", "刷新", launchRefresh, loading) : null,
      IconButton("external", "在 X 打开",
        open(rows.find(r => r.data) ? rows.find(r => r.data).data.url : "https://x.com"))),
    h("Canvas", { width: W, height: 2, commands: dither(W, 2, "border"), label: "" }));
}

function Problem(title, detail) {
  return h("Column", { tw: "grow items-center justify-center gap-2 py-6 px-8" },
    Icon("alert", 20, K.down),
    TX(title, { tw: "font-mono text-xs font-semibold text-center tracking-[1px]" }),
    TX(detail, { tw: "font-mono text-[10px] text-textMuted text-center leading-[1.5] max-w-[260px]" }));
}

function DeltaChip(delta) {
  if (delta === null) return null;
  const color = delta > 0 ? K.up : delta < 0 ? K.down : K.muted;
  return h("Row", { tw: "gap-1 items-center py-0.5 px-1.5 rounded-[2px] bg-surfaceHover shrink-0" },
    TX((delta > 0 ? "+" : "") + comma(delta),
      { tw: `font-mono text-[10px] font-semibold tabular-nums text-${color}` }),
    TX("7D", { tw: "font-mono text-[9px] text-textMuted" }));
}

function StatCell(label, value) {
  return h("Column", { tw: "gap-0.5 grow items-center min-w-0" },
    TX(label, { tw: "font-mono text-[8.5px] tracking-[1.2px] text-textMuted" }),
    TX(value, { tw: "font-mono text-[14px] font-semibold tabular-nums" }));
}

const vrule = () => h("Box", { tw: "w-px self-stretch bg-border" });

function PixelCard(row, primary) {
  const u = row.data;
  const t = trendFor(row.handle.toLowerCase(), u.followers);
  const dots = dotMatrix(heroNumber(u.followers), 300, 10, "text");
  const bars = pixelBars(t.bars, CARD_W, 38);
  return h("Column", {
      tw: `p-3 gap-2.5 w-full min-w-0 border bg-background ${primary ? "border-accent" : "border-" + cardBorder()}`,
      key: row.handle },
    h("Row", { tw: "gap-2.5 items-center w-full min-w-0" },
      h("Avatar", { src: u.avatar, name: u.name, width: 36, height: 36,
        tw: "shrink-0 border border-" + cardBorder(), label: "@" + u.handle }),
      h("Column", { tw: "gap-0.5 min-w-0 grow" },
        h("Row", { tw: "gap-1 items-center min-w-0" },
          TX(u.name, { tw: "text-[13px] font-semibold truncate min-w-0" }),
          u.verified ? Icon("check", 11, K.accent) : null),
        TX("@" + u.handle, { tw: "font-mono text-[10px] text-textMuted truncate" })),
      DeltaChip(t.delta),
      h("Row", { tw: "w-6 h-6 items-center justify-center shrink-0 cursor-pointer",
          hover: { background: K.hover },
          label: "在 X 打开 @" + u.handle, tooltip: "在 X 打开", onClick: open(u.url) },
        Icon("external", 13, K.muted))),
    h("Column", { tw: "gap-1 w-full min-w-0" },
      TX("FOLLOWERS", { tw: "font-mono text-[9px] tracking-[1.5px] text-textMuted" }),
      h("Canvas", { width: dots.width, height: dots.height, commands: dots.commands,
        label: comma(u.followers) + " 粉丝" })),
    h("Box", { tw: "h-px w-full bg-border" }),
    h("Row", { tw: "gap-2 items-center w-full min-w-0" },
      StatCell("FOLLOWING", compact(u.following)),
      vrule(),
      StatCell("POSTS", compact(u.tweets)),
      vrule(),
      StatCell("JOINED", u.joined || "—")),
    t.bars.length
      ? h("Column", { tw: "gap-1 w-full min-w-0" },
          TX("TREND", { tw: "font-mono text-[9px] tracking-[1.5px] text-textMuted" }),
          h("Canvas", { width: bars.width, height: bars.height, commands: bars.commands,
            label: "每日粉丝涨跌" }))
      : h("Row", { tw: "gap-1.5 items-center w-full min-w-0" },
          TX("TREND", { tw: "font-mono text-[9px] tracking-[1.5px] text-textMuted" }),
          TX("从今天开始采样", { tw: "font-mono text-[10px] text-textMuted" })));
}

function Card(row, primary) {
  if (!row.data) {
    return h("Column", {
        tw: `p-3 gap-1.5 w-full min-w-0 border bg-background ${primary ? "border-accent" : "border-" + cardBorder()}`,
        key: row.handle },
      h("Row", { tw: "gap-1.5 items-center min-w-0" },
        Icon("alert", 12, K.down),
        TX("@" + row.handle, { tw: "font-mono text-[11px] font-medium truncate min-w-0" })),
      TX(row.error || "还没有数据", { tw: "font-mono text-[10px] text-textMuted leading-[1.4]" }));
  }
  return PixelCard(row, primary);
}

function Skeleton() {
  const block = () => h("Column", { tw: `p-3 gap-3 w-full border border-${cardBorder()}` },
    h("Row", { tw: "gap-2.5 items-center" },
      h("Box", { tw: "w-9 h-9 bg-surfaceHover shrink-0" }),
      h("Column", { tw: "gap-1.5" },
        h("Box", { tw: "w-[120px] h-3 bg-surfaceHover" }),
        h("Box", { tw: "w-[80px] h-2 bg-surfaceHover" }))),
    h("Box", { tw: "w-[240px] h-14 bg-surfaceHover" }));
  return h("Column", { tw: "gap-3" }, [0, 1].map(block));
}

function Banner() {
  return h("Row", { tw: "gap-2 py-2 px-2.5 border border-danger items-center w-full min-w-0" },
    Icon("alert", 12, K.down),
    TX(error, { tw: "font-mono text-[10px] min-w-0 shrink grow leading-[1.4]" }),
    h("Row", { tw: "py-0.5 px-1.5 cursor-pointer shrink-0", hover: { background: K.hover },
        label: "重试", onClick: launchRefresh },
      TX("RETRY", { tw: "font-mono text-[9px] font-semibold tracking-[1px]" })));
}

function Body() {
  if (!target.length) return Problem("NO ACCOUNT", inputErr);
  const hasData = rows.some(r => r.data);
  if (!hasData && loading) return h("Column", { tw: "gap-3 p-3 w-full" }, Skeleton());
  if (!hasData && error) return Problem("LOAD FAILED", error);
  return h("Scroll", { tw: "grow min-h-0 w-full" },
    h("Column", { tw: "gap-3 p-3 w-full min-w-0" },
      error ? Banner() : null,
      rows.map((r, i) => Card(r, i === 0)),
      TX("FX / LOCAL SAMPLES", { tw: "font-mono text-[9px] text-textMuted text-center tracking-[1.5px] pt-0.5" })));
}

const panelTree = () => {
  hookTheme();
  return h("Column", {
    preferredWidth: W,
    preferredHeight: Math.min(560, 130 + Math.max(1, target.length) * 235),
    safeArea: true,
    tw: "size-full text-[13px] text-text min-w-0 min-h-0",
    shortcuts: { "CmdOrCtrl+R": launchRefresh },
  }, Header(), Body());
};

const trayTree = () => {
  const first = rows.find(r => r.data);
  const u = first && first.data;
  return {
    icon: "data:image/svg+xml," + encodeURIComponent(XMARK),
    iconTemplate: true,
    title: u ? compact(u.followers) : "",
    tooltip: u ? `${u.name} · ${comma(u.followers)} 粉丝` : target.length ? "@" + target[0].handle : "SteveFans",
    error: error || inputErr,
    menu: [
      { label: "刷新", onClick: launchRefresh, disabled: !target.length },
      ...(u ? [{ label: "在 X 打开 @" + u.handle, onClick: open(u.url) }] : []),
    ],
  };
};

export default {
  async scheduled(env) {
    sync(env);
    await refresh();
  },

  render(env) {
    sync(env);
    return { tray: trayTree(), panel: panelTree() };
  },

  event(name, payload) {
    if (name === "lifecycle" && payload && payload.type === "expand" && target.length && !inflight &&
        Date.now() - loadedAt > 120e3) launchRefresh();
  },
};
  ]]></script>
</bar>
